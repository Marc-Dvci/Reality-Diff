REALITYDIFF_ENV=production
GOOGLE_CLOUD_PROJECT=reality-diff
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
REALITYDIFF_GEMINI_MODEL=gemini-3.7-flash
REALITYDIFF_TRIAGE_MODEL=gemini-3.5-flash-lite
REALITYDIFF_EMBEDDING_MODEL=gemini-embedding-2
REALITYDIFF_MEDIA_BUCKET=reality-diff-reality-diff-media
REALITYDIFF_PUBSUB_TOPIC=reality-diff-ingestion
REALITYDIFF_STATE_PATH=/tmp/reality-diff-state.json
REALITYDIFF_UPLOADS_ROOT=/tmp/reality-diff-uploads
# For local AI Studio development only. On Cloud Run, use the runtime service
# account and Vertex AI instead of committing a key.
GEMINI_API_KEY=
